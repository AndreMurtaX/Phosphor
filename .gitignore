# Build output
/bin/

# FPC / Lazarus compiled artifacts
*.ppu
*.o
*.a
*.or
*.compiled
lib/
backup/

# Lazarus IDE session state (per-user, not part of the project)
*.lps
*.lpo

# The package's registration unit is GENERATED from the .lpk's own file list and
# says "Do not edit" in its first line. Committing it would put the list of units
# in two places, and this project has already been bitten by a second copy of a
# fact drifting away from the first.
/lazarus/phosphor_engine.pas

# Claude Code local tooling (dev-process, not part of the product)
.claude/

# Editor / OS noise
*.bak
*.~*
*.orig
Thumbs.db
.DS_Store

# crash dumps from tools run in the working tree
*.stackdump

# Python bytecode from the gate scripts (one .pyc was committed by accident
# on 6e3bdf6 and turned up in every diff since)
__pycache__/
*.pyc
