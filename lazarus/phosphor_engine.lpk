<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="phosphor_engine"/>
    <Type Value="RunTime"/>
    <Author Value="Andre Murta"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="/"/>
      <SearchPaths>
        <OtherUnitFiles Value="../engine;../engine/libs"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
          <CStyleOperator Value="False"/>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
      <Other>
        <CustomOptions Value="-vewn"/>
      </Other>
    </CompilerOptions>
    <Description Value="Phosphor BASIC -- an embeddable BASIC interpreter. The ENGINE only: no LCL, no console, no filesystem host. Add it to a project, create a TPhosphorEngine, point OnOutput somewhere and run a script. See ../../docs/embedding.md."/>
    <License Value="MIT"/>
    <Version Major="0" Minor="1"/>
