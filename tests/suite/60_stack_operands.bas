rem Twelve `for` loops, so twelve hidden __forN local slots on top of
rem the one that is written down. Nothing here says `local` twelve more
rem times, which is exactly why the width could arise unnoticed.
function forwide() local acc
  acc = 0
  for f1 = 1 to 2
    acc = acc + 1
  next
  for f2 = 1 to 2
    acc = acc + 1
  next
  for f3 = 1 to 2
    acc = acc + 1
  next
  for f4 = 1 to 2
    acc = acc + 1
  next
  for f5 = 1 to 2
    acc = acc + 1
  next
  for f6 = 1 to 2
    acc = acc + 1
  next
  for f7 = 1 to 2
    acc = acc + 1
  next
  for f8 = 1 to 2
    acc = acc + 1
  next
  for f9 = 1 to 2
    acc = acc + 1
  next
  for f10 = 1 to 2
    acc = acc + 1
  next
  for f11 = 1 to 2
    acc = acc + 1
  next
  for f12 = 1 to 2
    acc = acc + 1
  next
  return acc
end function

function zeroh(code%, msg$)
  hruns = hruns + 1
  return 0
end function
