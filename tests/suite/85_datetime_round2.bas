rem ---------------------------------------------------------------
rem THE CALENDAR IS A LINE, AND A TDATETIME IS NOT ONE (2026-10-09,
rem round 2 of the adversarial loop).
rem
rem A date before 1899-12-30 is a NEGATIVE number, and FPC spells it
rem sign-and-magnitude: the day is the integer part and the time of day
rem is the absolute value of the fraction, so noon on 1850-06-15 is
rem -18095.5 where midnight that day is -18095. The time of day moves
rem the number DOWN. DateUtils' arithmetic is written for the positive
rem half and patched at the epoch, and the patch was wrong:
rem   * incday and incweek moved a midnight one day too far whenever the
rem     step crossed 1899-12-30 (MaybeSkipTimeWarp: its 2.2e-16 nudge is
rem     lost in a sum whose magnitude is 2 or more);
rem   * weekoftheyear and weekof answered the PREVIOUS ISO week for a
rem     pre-1900 Monday carrying a time of day (DecodeDateWeek counts the
rem     day of the year by subtracting two sign-and-magnitude numbers);
rem   * inchour, incminute, incsecond and incmillisecond took their step
rem     through a 32-bit narrowing, so 2^31 minutes from 2000-01-01 --
rem     6083-01-23 02:08 -- came back as 02:07, and incweek(0, 1e300)
rem     came back as 15032385529, which is 2^31 - 1 weeks, both without a
rem     word;
rem   * strtodate, strtotime and strtodatetime took text that is not the
rem     ISO 8601 the page documents and INVENTED the missing parts: "0-6-15"
rem     was 2000-06-15, "06-15" was June 15 of the current year, "10" was the
rem     10th of the current month, "1:2" was 01:02 and "10:20:30 PM" was
rem     22:20:30.
rem
rem The library now does its arithmetic on a LINEAR quantity -- the day
rem number and the time of day as two separate parts -- and converts back
rem to the sign-and-magnitude spelling once, at the end; and its parsers
rem read the ISO forms the page lists and refuse everything else.
rem
rem EVERY EXPECTED VALUE HERE IS DERIVED, NOT READ OFF A RUN. The named
rem cases carry their arithmetic beside them; the generated block at the
rem end comes from Python's proleptic Gregorian datetime and from integer
rem arithmetic (tests/datetime_round2_sweep.py, which also says what the grid
rem crosses), and `mk` below is the only place the sign-and-magnitude rule
rem is written: D + ms/86400000 at or after the epoch, D - ms/86400000
rem before it.
rem ---------------------------------------------------------------

function mk(dd, ms)
  if dd < 0 then return dd - ms / 86400000
  return dd + ms / 86400000
endfunction

rem One failure counter and one first-failure description per family, so a
rem failing run says WHICH family broke and on which case.
fc = 0
fk = 0
fm = 0
fp = 0
ft = 0
firstc$ = ""
firstk$ = ""
firstm$ = ""
firstp$ = ""
firstt$ = ""
nc = 0
nk = 0
nm = 0
np = 0
nt = 0

function where$(dd, ms)
  return str$(dd) + "/" + str$(ms)
endfunction

function c(dd, ms, sig, sig2, ymd, hms) local v, g, g2, y, h
  nc = nc + 1
  v = mk(dd, ms)
  g = (((weekoftheyear(v) * 10 + weekofthemonth(v)) * 10 + dayoftheweek(v)) * 1000 + dayoftheyear(v)) * 100 + weeksinyear(v)
  g2 = (dayofweek(v) * 100 + daysinmonth(v)) * 1000 + daysinyear(v)
  y = yearof(v) * 10000 + monthof(v) * 100 + dayof(v)
  h = hourof(v) * 10000000 + minuteof(v) * 100000 + secondof(v) * 1000 + millisecondof(v)
  if g <> sig or g2 <> sig2 or y <> ymd or h <> hms or weekof(v) <> weekoftheyear(v) then
    fc = fc + 1
    if firstc$ = "" then firstc$ = where$(dd, ms) + " week/wom/dow/doy/wiy " + str$(g) + " where " + str$(sig) + ", " + str$(g2) + " where " + str$(sig2) + ", " + str$(y) + " " + str$(h)
  endif
  return 0
endfunction

function step(u, t, n)
  if u = 1 then return incday(t, n)
  if u = 2 then return incweek(t, n)
  if u = 3 then return inchour(t, n)
  if u = 4 then return incminute(t, n)
  if u = 5 then return incsecond(t, n)
  return incmillisecond(t, n)
endfunction

rem Two answers are compared as INSTANTS, on the line: day plus time of day,
rem undoing the spelling `mk` writes. Comparing the spelled numbers would
rem call a result 2e-10 of a day before a pre-1900 midnight two whole days
rem wrong -- the spelling jumps there -- and would call -0.25 and +0.25,
rem which are one instant, different.
function lin(x)
  rem past 2^52 a Double has no fraction, and fix() refuses past 2^63
  if abs(x) >= 4503599627370496 then return x
  return fix(x) + abs(x - fix(x))
endfunction

rem Inside the calendar a step lands on a millisecond, and 2e-9 of a day is
rem a fifth of one: a wrong day, a wrong time of day or a millisecond off are
rem each at least five times that. And the answer must RENDER as the
rem expected instant -- to the millisecond, the precision every renderer and
rem decomposition reads.
function k(u, dd, ms, n, ed, ems) local r, e
  nk = nk + 1
  r = step(u, mk(dd, ms), n)
  e = mk(ed, ems)
  if abs(lin(r) - lin(e)) > 0.000000002 or formatdatetime$("yyyymmddhhnnsszzz", r) <> formatdatetime$("yyyymmddhhnnsszzz", e) then
    fk = fk + 1
    if firstk$ = "" then firstk$ = "unit " + str$(u) + " from " + where$(dd, ms) + " by " + str$(n) + ": " + str$(r) + " where " + str$(e)
  endif
  return 0
endfunction

rem Outside the calendar the answer is the plain sum, to a relative
rem precision far finer than any clipping of the step could pass.
function kx(u, dd, ms, n, e) local r
  nk = nk + 1
  r = step(u, mk(dd, ms), n)
  if abs(lin(r) - lin(e)) > abs(e) * 0.000000001 then
    fk = fk + 1
    if firstk$ = "" then firstk$ = "unit " + str$(u) + " from " + where$(dd, ms) + " by " + str$(n) + ": " + str$(r) + " where " + str$(e)
  endif
  return 0
endfunction

rem incmonth and incyear: `r` and `rf` are set by the caller, which ran the
rem step at the top level under a trap so that a refusal is caught there (a
rem label belongs to the program, never to a function). ems = -1 means
rem refused. `rf` is cleared here, ready for the next case.
function mo(u, dd, ms, n, ed, ems) local bad
  nm = nm + 1
  bad = 0
  if ems < 0 then
    if rf = 0 then bad = 1
  else
    if rf <> 0 then bad = 1
    if rf = 0 and abs(lin(r) - lin(mk(ed, ems))) > 0.000000002 then bad = 1
  endif
  if bad <> 0 then
    fm = fm + 1
    if firstm$ = "" then firstm$ = "unit " + str$(u) + " from " + where$(dd, ms) + " by " + str$(n) + ": refused " + str$(rf) + ", " + str$(r) + " where " + str$(ed) + "/" + str$(ems)
  endif
  rf = 0
  return 0
endfunction

function p(d1, ms1, d2, ms2, delta) local a, b, bad
  np = np + 1
  a = mk(d1, ms1)
  b = mk(d2, ms2)
  bad = 0
  if millisecondsbetween(a, b) <> delta then bad = 1
  if secondsbetween(b, a) <> int(delta / 1000) then bad = 1
  if minutesbetween(a, b) <> int(delta / 60000) then bad = 1
  if hoursbetween(b, a) <> int(delta / 3600000) then bad = 1
  if daysbetween(a, b) <> int(delta / 86400000) then bad = 1
  if weeksbetween(b, a) <> int(delta / 604800000) then bad = 1
  if abs(dayspan(a, b) - delta / 86400000) > 0.000000002 then bad = 1
  if bad <> 0 then
    fp = fp + 1
    if firstp$ = "" then firstp$ = where$(d1, ms1) + " to " + where$(d2, ms2) + " is " + str$(delta) + " ms"
  endif
  return 0
endfunction

function tx(dd, ms, text$) local v
  nt = nt + 1
  v = mk(dd, ms)
  if datetimetostr$(v) <> text$ or strtodatetime(text$) <> v then
    ft = ft + 1
    if firstt$ = "" then firstt$ = where$(dd, ms) + " renders " + datetimetostr$(v) + " where " + text$
  endif
  return 0
endfunction

goto start

rem The one handler every expected refusal below goes through. It records,
rem and `resume next` returns to the statement after the one that failed.
refused:
rf = 1
msgs$ = msgs$ + errmsg$() + "|"
resume next

start:

test_case("datetime-r2/a midnight step across 1899-12-30 lands on the right day")
rem 1899-12-29 is day -1; six days on is 1899-12-30, 31, 1900-01-01, 02,
rem 03, 04 -- 1900-01-04, day 5. The RTL answered 6.
assert_eq(incday(encodedate(1899, 12, 29), 6), encodedate(1900, 1, 4), "six days after 1899-12-29 is 1900-01-04")
assert_eq(incday(encodedate(1900, 1, 4), -6), encodedate(1899, 12, 29), "and six days before 1900-01-04 is 1899-12-29")
rem 1899-12-20 plus two weeks: 20 + 14 = 34 = 31 + 3, so 1900-01-03.
assert_eq(incweek(encodedate(1899, 12, 20), 2), encodedate(1900, 1, 3), "two weeks after 1899-12-20 is 1900-01-03")
assert_eq(incweek(encodedate(1900, 1, 3), -2), encodedate(1899, 12, 20), "and back again")
rem With a time of day: 1899-12-29 18:00 is -1.75 in the spelling, and one
rem day on is 1899-12-30 18:00, which is +0.75.
assert_eq(incday(mk(-1, 64800000), 1), 0.75, "a time of day is carried across the epoch, not mirrored")
assert_eq(inchour(mk(-1, 64800000), 12), 0.25, "and twelve hours after 1899-12-29 18:00 is 1899-12-30 06:00")

test_case("datetime-r2/the ISO week of a pre-1900 Monday does not depend on its time of day")
rem Python: date(1850, 6, 17).isocalendar() is (1850, 25, 1) -- a Monday in
rem week 25 -- and that date is day -18093.
mon = encodedate(1850, 6, 17)
assert_eq(dayoftheweek(mon), 1, "1850-06-17 is a Monday")
assert_eq(weekoftheyear(mon), 25, "in ISO week 25 at midnight")
assert_eq(weekoftheyear(mk(-18093, 43200000)), 25, "and still at noon -- not week 24")
assert_eq(weekof(mk(-18093, 86399999)), 25, "and at the last millisecond of the day")
rem 1899-12-25 is a Monday in week 52 of 1899; 1600-01-03 a Monday in week 1.
assert_eq(weekoftheyear(mk(-5, 3600000)), 52, "1899-12-25 01:00 is in week 52")
assert_eq(weekoftheyear(mk(-109569, 1)), 1, "1600-01-03 00:00:00.001 is in week 1 of 1600")

test_case("datetime-r2/a step is a quantity, not an index, and is never clipped")
rem Python: datetime(2000, 1, 1) + timedelta(minutes=2**31) is
rem 6083-01-23 02:08:00. The 32-bit narrowing made it 2^31 - 1 minutes:
rem 02:07.
y2k = encodedate(2000, 1, 1)
assert_eq(datetimetostr$(incminute(y2k, 2147483648)), "6083-01-23 02:08:00", "two to the 31st minutes after 2000-01-01")
rem timedelta(seconds=3*10**9) after 2000-01-01 is 2095-01-24 05:20:00.
assert_eq(datetimetostr$(incsecond(y2k, 3000000000)), "2095-01-24 05:20:00", "three thousand million seconds")
rem timedelta(milliseconds=2**31 + 1) after 2000-01-01 is
rem 2000-01-25 20:31:23.649.
assert_eq(formatdatetime$("yyyy-mm-dd hh:nn:ss.zzz", incmillisecond(y2k, 2147483649)), "2000-01-25 20:31:23.649", "two to the 31st milliseconds and one")
rem datetime(6000, 1, 1) - timedelta(minutes=2**31) is 1916-12-08 21:52:00.
assert_eq(datetimetostr$(incminute(encodedate(6000, 1, 1), -2147483648)), "1916-12-08 21:52:00", "and the same distance backwards")
rem A step far outside the calendar answers the plain sum, outside it.
assert_eq(incweek(0, 1e300), 7e300, "1e300 weeks from the epoch is 7e300 days, not a clipped step")
assert_eq(incday(0, -1e300), -1e300, "and backwards")
rem And a sum that is no number at all is refused by the engine's finiteness
rem gate, as every library result is, rather than clipped into one.
rf = 0
msgs$ = ""
on error goto refused
x = incweek(0, 1e308)
on error goto 0
assert_eq(rf, 1, "1e308 weeks has no finite answer and is refused")
assert_true(instr(msgs$, "no finite result") > 0, "by the engine's own finiteness gate")

test_case("datetime-r2/the parsers read exactly the ISO forms the page lists")
rem The expected numbers: encodedate's, and for a time hh*3600 + nn*60 + ss
rem seconds over 86400. 1850-06-15 is day -18095, so 06:00 that day is
rem -18095 - 0.25.
assert_eq(strtodate("2020-06-15"), encodedate(2020, 6, 15), "yyyy-mm-dd")
assert_eq(strtodate("0001-01-01"), encodedate(1, 1, 1), "the first day")
assert_eq(strtodate("9999-12-31"), encodedate(9999, 12, 31), "the last day")
assert_eq(strtodate("2024-02-29"), encodedate(2024, 2, 29), "a leap day in a leap year")
assert_eq(strtotime("10:20"), (10 * 3600 + 20 * 60) / 86400, "hh:nn")
assert_eq(strtotime("10:20:30"), (10 * 3600 + 20 * 60 + 30) / 86400, "hh:nn:ss")
assert_eq(strtotime("00:00"), 0, "midnight")
assert_eq(strtotime("23:59:59"), 86399 / 86400, "the last second")
assert_eq(strtodatetime("2020-06-15 10:20:30"), encodedate(2020, 6, 15) + (10 * 3600 + 20 * 60 + 30) / 86400, "yyyy-mm-dd hh:nn:ss")
assert_eq(strtodatetime("2020-06-15 10:20"), encodedate(2020, 6, 15) + (10 * 3600 + 20 * 60) / 86400, "yyyy-mm-dd hh:nn")
assert_eq(strtodatetime("2020-06-15"), encodedate(2020, 6, 15), "the date alone, which is how datetimetostr$ renders a midnight")
assert_eq(strtodatetime("1850-06-15 06:00:00"), -18095.25, "a pre-1900 time of day moves the number down")

rem Everything else is refused, and none of it is completed by a guess. Each
rem list is the text of one assertion's worth of cases, "|"-separated; the
rem counts are written out by hand.
bad_dates$ = "20-06-15|0000-06-15|0-6-15|2020-6-5|2020-06-5|2020-6-15| 2020-06-15|2020-06-15 |06-15|2020|10|02020-06-15|2020-02-30|2023-02-29|2020-13-01|2020-00-10|2020-06-00|2020-06-15 10:00:00|2020/06/15|+2020-06-15|2020-06-1x|-2020-06-15|2020--06-15|2020-06-15" + chr$(0)
rf = 0
nrefused = 0
msgs$ = ""
for i = 1 to 24
  rf = 0
  on error goto refused
  x = strtodate(word$(bad_dates$, i, "|"))
  on error goto 0
  nrefused = nrefused + rf
next
rf = 0
on error goto refused
x = strtodate("")
on error goto 0
nrefused = nrefused + rf
assert_eq(nrefused, 25, "strtodate refuses all twenty-five, the empty text included")
assert_eq(countstr(msgs$, "invalid date:"), 25, "each with the message the page documents")

bad_times$ = "1:2|1:02|10:2|10|24:00|10:60|10:20:60|10:20:30.400|10:20:30 PM| 10:20|10:20 |10:20:30:40|-1:00|10.20|10:20:3|2020-06-15"
nrefused = 0
msgs$ = ""
for i = 1 to 16
  rf = 0
  on error goto refused
  x = strtotime(word$(bad_times$, i, "|"))
  on error goto 0
  nrefused = nrefused + rf
next
rf = 0
on error goto refused
x = strtotime("")
on error goto 0
nrefused = nrefused + rf
assert_eq(nrefused, 17, "strtotime refuses all seventeen")
assert_eq(countstr(msgs$, "invalid time:"), 17, "each with the message the page documents")

bad_stamps$ = "2020-06-15T10:00:00|2020-06-15 10|20-06-15 10:00|10:20|10:20:30|2020-06-15  10:00|2020-06-15 10:00:00 |2020-06-15 24:00|0-6-15 10:00|2020-6-15 10:00:00|2020-06-15 1:00"
nrefused = 0
msgs$ = ""
for i = 1 to 11
  rf = 0
  on error goto refused
  x = strtodatetime(word$(bad_stamps$, i, "|"))
  on error goto 0
  nrefused = nrefused + rf
next
assert_eq(nrefused, 11, "strtodatetime refuses all eleven")
assert_eq(countstr(msgs$, "invalid datetime:"), 11, "each with the message the page documents")

test_case("datetime-r2/a moment half a millisecond before midnight is read as that midnight")
rem Every reader rounds to the millisecond. 1899-12-29 23:59:59.9997 rounds
rem to 1899-12-30 00:00:00.000 -- the RTL rounded the spelled number away
rem from zero, which before the epoch is an EARLIER day, and read it as
rem 1899-12-28. 0001-01-01 23:59:59.9997 is 0001-01-02 00:00 (a Tuesday,
rem whose Thursday is 0001-01-04: week 1 of January), and the RTL read it as
rem a day of year 0 and RAISED out of weekofthemonth.
late = mk(-1, 86399999.7)
assert_eq(datetostr$(late), "1899-12-30", "1899-12-29 23:59:59.9997 reads as 1899-12-30")
assert_eq(dayofweek(late), dayofweek(0), "and dayofweek agrees with the date")
assert_eq(hourof(late), 0, "at hour 0")
first_late = mk(-693593, 86399999.7)
assert_eq(datetostr$(first_late), "0001-01-02", "0001-01-01 23:59:59.9997 reads as 0001-01-02")
assert_eq(weekofthemonth(first_late), 1, "and its week of the month is 1, not an exception")

